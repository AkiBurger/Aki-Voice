data/*
!data/setsuna/
data/setsuna/*
!data/setsuna/*.py
outputs/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.opus
*.list

# ---- 编译产物（启动器 exe 走 GitHub Release，不进仓库）----
/AkiBurgerVoice.exe
*.exe

# ---- 训练产物 ----
logs/
GPT_weights*/
SoVITS_weights*/
TEMP/

